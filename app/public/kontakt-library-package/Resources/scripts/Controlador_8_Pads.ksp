{ ============================================================ }
{ BIBLIOTECA KONTAKT - CONTROLADOR DE 8 PADS                  }
{ ============================================================ }

on init
  make_perf_title("Controlador 8 Pads Studio")
  set_ui_height_px(340)
  set_script_title("8-Pad Trigger Script")
  
  declare $last_event_id
  declare $midi_note_1 := 36
  declare $midi_note_2 := 37
  declare $midi_note_3 := 38
  declare $midi_note_4 := 39
  declare $midi_note_5 := 40
  declare $midi_note_6 := 41
  declare $midi_note_7 := 42
  declare $midi_note_8 := 43

  declare ui_button $pad_1
  declare ui_button $pad_2
  declare ui_button $pad_3
  declare ui_button $pad_4
  declare ui_button $pad_5
  declare ui_button $pad_6
  declare ui_button $pad_7
  declare ui_button $pad_8

  set_text($pad_1, "1. KICK 808")
  set_text($pad_2, "2. SNARE")
  set_text($pad_3, "3. HIHAT FECHADO")
  set_text($pad_4, "4. HIHAT ABERTO")
  set_text($pad_5, "5. CLAP / RIM")
  set_text($pad_6, "6. PERC BELL")
  set_text($pad_7, "7. SYNTH STAB")
  set_text($pad_8, "8. VOX CHANT")

  move_control_px($pad_1, 50, 80)
  set_control_par($pad_1, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_1, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_2, 175, 80)
  set_control_par($pad_2, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_2, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_3, 300, 80)
  set_control_par($pad_3, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_3, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_4, 425, 80)
  set_control_par($pad_4, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_4, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_5, 50, 185)
  set_control_par($pad_5, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_5, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_6, 175, 185)
  set_control_par($pad_6, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_6, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_7, 300, 185)
  set_control_par($pad_7, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_7, $CONTROL_PAR_HEIGHT, 85)

  move_control_px($pad_8, 425, 185)
  set_control_par($pad_8, $CONTROL_PAR_WIDTH, 110)
  set_control_par($pad_8, $CONTROL_PAR_HEIGHT, 85)

  message("Biblioteca de 8 Pads carregada com sucesso!")
end on

on note
  ignore_event($EVENT_ID)
  if ($EVENT_NOTE = $midi_note_1)
    $pad_1 := 1
    play_note(36, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_2)
    $pad_2 := 1
    play_note(37, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_3)
    $pad_3 := 1
    play_note(38, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_4)
    $pad_4 := 1
    play_note(39, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_5)
    $pad_5 := 1
    play_note(40, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_6)
    $pad_6 := 1
    play_note(41, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_7)
    $pad_7 := 1
    play_note(42, $EVENT_VELOCITY, 0, -1)
  end if
  if ($EVENT_NOTE = $midi_note_8)
    $pad_8 := 1
    play_note(43, $EVENT_VELOCITY, 0, -1)
  end if
end on

on release
  if ($EVENT_NOTE = $midi_note_1)
    $pad_1 := 0
  end if
  if ($EVENT_NOTE = $midi_note_2)
    $pad_2 := 0
  end if
  if ($EVENT_NOTE = $midi_note_3)
    $pad_3 := 0
  end if
  if ($EVENT_NOTE = $midi_note_4)
    $pad_4 := 0
  end if
  if ($EVENT_NOTE = $midi_note_5)
    $pad_5 := 0
  end if
  if ($EVENT_NOTE = $midi_note_6)
    $pad_6 := 0
  end if
  if ($EVENT_NOTE = $midi_note_7)
    $pad_7 := 0
  end if
  if ($EVENT_NOTE = $midi_note_8)
    $pad_8 := 0
  end if
end on
